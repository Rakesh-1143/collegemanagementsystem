# MongoDB connection string (Atlas or local)
CONNECTION_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/college_erp

# REQUIRED - used to sign/verify JWTs. Use a long random string.
JWT_SECRET=your_secret_here

# Optional. Comma-separated browser origins allowed to call the API (CORS).
# CLIENT_URL=http://localhost:3000

# Optional. Set to "production" in deployed environments.
# NODE_ENV=production